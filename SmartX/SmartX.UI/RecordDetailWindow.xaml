<Window x:Class="SmartX.UI.RecordDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Details"
        Height="480"
        Width="520"
        MinHeight="360"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a2e"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtDetailTitle"
                   Grid.Row="0"
                   Text="Record Details"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#00d4ff"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Background="#2a2a3e"
                BorderBrush="#444"
                BorderThickness="1"
                CornerRadius="5"
                Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DetailItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Key}"
                                           Foreground="#888"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           Foreground="#00d4ff"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <TextBlock x:Name="TxtAttachmentStatus"
                       Foreground="#ffaa00"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="BtnDownloadAttachment"
                        Content="Download / Open Attachment"
                        Background="#0f3460"
                        Foreground="#00d4ff"
                        FontWeight="Bold"
                        Padding="10,6"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Click="BtnDownloadAttachment_Click"/>

                <Button x:Name="BtnCloseDetail"
                        Content="Close"
                        Width="100"
                        Background="#0f3460"
                        Foreground="#00d4ff"
                        FontWeight="Bold"
                        Padding="10,6"
                        Click="BtnCloseDetail_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
