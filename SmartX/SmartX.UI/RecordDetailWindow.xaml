<Window x:Class="SmartX.UI.RecordDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Details" Height="440" Width="500"
        WindowStartupLocation="CenterOwner" Background="#1a1a2e"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtDetailTitle" Grid.Row="0" Text="Record Details" FontSize="18" FontWeight="Bold"
                   Foreground="#00d4ff" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#2a2a3e" BorderBrush="#444" BorderThickness="1" CornerRadius="5" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DetailItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Key}" Foreground="#888" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#00d4ff" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button x:Name="BtnCloseDetail" Grid.Row="2" Content="Close" Width="120" HorizontalAlignment="Right"
                Background="#0f3460" Foreground="#00d4ff" FontWeight="Bold" Margin="0,15,0,0" Click="BtnCloseDetail_Click"/>
    </Grid>
</Window>