<UserControl x:Class="SmartX.UI.Views.NavBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="70">
    <Grid Background="#0f3460">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="BtnLanding" Grid.Column="0" Tag="Landing" Content="DashBoard"
                Margin="4" Background="#0f3460" Foreground="#00d4ff" FontWeight="Bold"
                BorderBrush="#00d4ff" BorderThickness="1" Click="NavButton_Click"/>
        <Button x:Name="BtnTelemetry" Grid.Column="1" Tag="Telemetry" Content="View Telemetry"
                Margin="4" Background="#0f3460" Foreground="#00d4ff" FontWeight="Bold"
                BorderBrush="#00d4ff" BorderThickness="1" Click="NavButton_Click"/>
        <Button x:Name="BtnCommandStream" Grid.Column="2" Tag="CommandStream" Content="Real-Time Command Stream"
                Margin="4" Background="#0f3460" Foreground="#00d4ff" FontWeight="Bold"
                BorderBrush="#00d4ff" BorderThickness="1" Click="NavButton_Click"/>
        <Button x:Name="BtnTopology" Grid.Column="3" Tag="Topology" Content="Network Topology"
                Margin="4" Background="#0f3460" Foreground="#00d4ff" FontWeight="Bold"
                BorderBrush="#00d4ff" BorderThickness="1" Click="NavButton_Click"/>
    </Grid>
</UserControl>