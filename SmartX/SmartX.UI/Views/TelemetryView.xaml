<UserControl x:Class="SmartX.UI.Views.TelemetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartX.UI.Views"
             Background="#1a1a2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:NavBarControl x:Name="NavBar" Grid.Row="0"/>

        <Grid Grid.Row="1"
              Background="#0f3460"
              Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="SMART-X DASHBOARD"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#00d4ff"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="ApiStatusBadge"
                       Grid.Column="1"
                       Text="API: CHECKING"
                       Foreground="#ffaa00"
                       FontSize="12"
                       Margin="15,0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>

            <TextBlock Grid.Column="2"
                       Text="Last Update:"
                       Foreground="#888"
                       FontSize="11"
                       Margin="10,0"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="LastUpdateTime"
                       Grid.Column="3"
                       Text="00:00:00"
                       Foreground="#00d4ff"
                       FontSize="11"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0"
                       Grid.Column="0"
                       Margin="0,0,0,15">
                <Button x:Name="BtnViewTelemetry"
                        Content="View Telemetry"
                        MinWidth="140"
                        Padding="10,6"
                        Background="#0f3460"
                        Foreground="#00d4ff"
                        FontWeight="Bold"
                        Click="BtnViewTelemetry_Click"
                        Margin="0,0,10,8"/>

                <TextBox x:Name="SearchInput"
                         Width="220"
                         Background="#2a2a3e"
                         Foreground="#fff"
                         Padding="10"
                         TextChanged="SearchInput_TextChanged"
                         Margin="0,0,10,8"/>

                <Button x:Name="BtnSearchHistory"
                        Content="Search History"
                        MinWidth="140"
                        Padding="10,6"
                        Background="#0f3460"
                        Foreground="#00d4ff"
                        FontWeight="Bold"
                        Click="BtnSearchHistory_Click"
                        Margin="0,0,10,8"/>

                <Button x:Name="BtnClearSearch"
                        Content="Clear Search"
                        MinWidth="100"
                        Padding="10,6"
                        Background="#0f3460"
                        Foreground="#00d4ff"
                        FontWeight="Bold"
                        Click="BtnClearSearch_Click"
                        Margin="0,0,10,8"/>

                <Button x:Name="BtnRunPerformanceTest"
                        Content="Performance Test"
                        MinWidth="145"
                        Padding="10,6"
                        Background="#ff4444"
                        Foreground="#fff"
                        FontWeight="Bold"
                        Click="BtnRunPerformanceTest_Click"
                        Margin="0,0,10,8">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="100"
                                      Click="PerformanceTest100_Click"/>
                            <MenuItem Header="1000"
                                      Click="PerformanceTest1000_Click"/>
                            <MenuItem Header="5000"
                                      Click="PerformanceTest5000_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>

            <TabControl Grid.Row="1"
                        Grid.Column="0"
                        Background="#2a2a3e"
                        BorderBrush="#444"
                        BorderThickness="1">

                <TabItem Header="Local Telemetry">
                    <Border Background="#2a2a3e">
                        <DataGrid x:Name="TelemetryDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="#1a1a2e"
                                  Foreground="#00d4ff"
                                  GridLinesVisibility="None"
                                  RowBackground="#2a2a3e"
                                  AlternatingRowBackground="#252535"
                                  MouseDoubleClick="TelemetryRecordGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MAC Address"
                                                    Binding="{Binding MacAddress}"
                                                    Width="1.3*"
                                                    Foreground="#00d4ff"/>
                                <DataGridTextColumn Header="Location"
                                                    Binding="{Binding LocationZone}"
                                                    Width="*"
                                                    Foreground="#00d4ff"/>
                                <DataGridTextColumn Header="Category"
                                                    Binding="{Binding Category}"
                                                    Width="1.1*"
                                                    Foreground="#00d4ff"/>
                                <DataGridTextColumn Header="Sensor Value"
                                                    Binding="{Binding SensorValue}"
                                                    Width="*"
                                                    Foreground="#00d4ff"/>
                                <DataGridTextColumn Header="Source"
                                                    Binding="{Binding Source}"
                                                    Width="1.2*"
                                                    Foreground="#ffaa00"/>
                                <DataGridTextColumn Header="Timestamp"
                                                    Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                    Width="1.6*"
                                                    Foreground="#00d4ff"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <TabItem Header="Shared API Telemetry">
                    <Grid Background="#2a2a3e" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                            <Button x:Name="BtnGenerateWithApi"
                                    Content="Generate Telemetry (API +10)"
                                    MinWidth="170"
                                    Padding="10,6"
                                    Background="#0f3460"
                                    Foreground="#00d4ff"
                                    FontWeight="Bold"
                                    Click="BtnGenerateWithApi_Click"
                                    Margin="0,0,10,8"/>

                            <Button x:Name="BtnRefreshApiData"
                                    Content="Refresh from API"
                                    MinWidth="140"
                                    Padding="10,6"
                                    Background="#0f3460"
                                    Foreground="#00d4ff"
                                    FontWeight="Bold"
                                    Click="BtnRefreshApiData_Click"
                                    Margin="0,0,20,8"/>

                            <TextBlock Text="Registered Sensors:"
                                       Foreground="#888"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,8"/>

                            <TextBlock x:Name="TxtApiSensorCount"
                                       Text="0"
                                       Foreground="#00ff00"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,20,8"/>

                            <TextBlock Text="Shared API Generated:"
                                       Foreground="#888"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,8"/>

                            <TextBlock x:Name="TxtApiGeneratedInline"
                                       Text="0"
                                       Foreground="#ffaa00"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,8"/>
                        </WrapPanel>

                        <Border Grid.Row="1"
                                Background="#2a2a3e"
                                BorderBrush="#444"
                                BorderThickness="1"
                                CornerRadius="5">
                            <DataGrid x:Name="ApiDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="#1a1a2e"
                                      Foreground="#00d4ff"
                                      GridLinesVisibility="None"
                                      RowBackground="#2a2a3e"
                                      AlternatingRowBackground="#252535"
                                      MouseDoubleClick="TelemetryRecordGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MAC Address"
                                                        Binding="{Binding MacAddress}"
                                                        Width="1.3*"
                                                        Foreground="#00d4ff"/>
                                    <DataGridTextColumn Header="Location"
                                                        Binding="{Binding LocationZone}"
                                                        Width="*"
                                                        Foreground="#00d4ff"/>
                                    <DataGridTextColumn Header="Category"
                                                        Binding="{Binding Category}"
                                                        Width="1.1*"
                                                        Foreground="#00d4ff"/>
                                    <DataGridTextColumn Header="Value / Description"
                                                        Binding="{Binding SensorValue}"
                                                        Width="1.4*"
                                                        Foreground="#00d4ff"/>
                                    <DataGridTextColumn Header="Source"
                                                        Binding="{Binding Source}"
                                                        Width="1.3*"
                                                        Foreground="#ffaa00"/>
                                    <DataGridTextColumn Header="Timestamp"
                                                        Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                        Width="1.6*"
                                                        Foreground="#00d4ff"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2"
                  Grid.Column="0"
                  Margin="0,15,15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#2a2a3e"
                        BorderBrush="#ff4444"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="0,0,7,0"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="ACTIVE ALERTS"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#ff4444"
                                   Margin="0,0,0,4"/>

                        <TextBlock x:Name="TxtActiveAlertCount"
                                   Text="0 active"
                                   Foreground="#ff6666"
                                   FontSize="11"
                                   Margin="0,0,0,6"/>

                        <ListBox x:Name="AlertsListBox"
                                 Background="#1a1a2e"
                                 BorderThickness="0"
                                 MaxHeight="120"
                                 Foreground="#ff6666"
                                 MouseDoubleClick="AlertsListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="11"
                                               Margin="5"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="#ff6666"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SeverityLevel}"
                                                                 Value="High">
                                                        <Setter Property="Foreground"
                                                                Value="#ff4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SeverityLevel}"
                                                                 Value="Medium">
                                                        <Setter Property="Foreground"
                                                                Value="#ffaa00"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SeverityLevel}"
                                                                 Value="Low">
                                                        <Setter Property="Foreground"
                                                                Value="#00d4ff"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsResolved}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="#666666"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="#2a2a3e"
                        BorderBrush="#00aa55"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="7,0,0,0"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="RESOLVED ALERTS"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#00cc66"
                                   Margin="0,0,0,4"/>

                        <TextBlock x:Name="TxtResolvedAlertCount"
                                   Text="0 resolved"
                                   Foreground="#66cc99"
                                   FontSize="11"
                                   Margin="0,0,0,6"/>

                        <ListBox x:Name="ResolvedAlertsListBox"
                                 Background="#1a1a2e"
                                 BorderThickness="0"
                                 MaxHeight="120"
                                 Foreground="#66cc99"
                                 MouseDoubleClick="ResolvedAlertsListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="#66cc99"
                                               FontSize="11"
                                               Margin="5"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Margin="15,0,0,0"
                    Background="#2a2a3e"
                    BorderBrush="#444"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="SYSTEM METRICS"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#00d4ff"
                                   Margin="0,0,0,20"/>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Total Sensors"
                                       Foreground="#888"
                                       FontSize="11"/>
                            <TextBlock x:Name="TxtTotalSensors"
                                       Text="0"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#00ff00"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Telemetry Generated"
                                       Foreground="#888"
                                       FontSize="11"/>
                            <TextBlock x:Name="TxtTelemetryGenerated"
                                       Text="0"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#00d4ff"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Telemetry Received"
                                       Foreground="#888"
                                       FontSize="11"/>
                            <TextBlock x:Name="TxtTelemetryReceived"
                                       Text="0"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#00d4ff"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Total Records Stored"
                                       Foreground="#888"
                                       FontSize="11"/>
                            <TextBlock x:Name="TxtTotalRecordsStored"
                                       Text="0"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#00ff00"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Last Telemetry Reading"
                                       Foreground="#888"
                                       FontSize="11"/>
                            <TextBlock x:Name="TxtLastReading"
                                       Text="--:--:--"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#00d4ff"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Insertion Time (ms)"
                                       Foreground="#888"
                                       FontSize="11"/>
                            <TextBlock x:Name="TxtInsertionTime"
                                       Text="0"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#ffaa00"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Search Time (ms)"
                                       Foreground="#888"
                                       FontSize="11"/>
                            <TextBlock x:Name="TxtSearchTime"
                                       Text="0"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#ffaa00"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="API Generated"
                                       Foreground="#888"
                                       FontSize="11"/>
                            <TextBlock x:Name="TxtApiGenerated"
                                       Text="0"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#ffaa00"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Recent Readings By Zone"
                                       Foreground="#888"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtRecentReadingsByZone"
                                       Text="Waiting for readings..."
                                       FontSize="11"
                                       Foreground="#00d4ff"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Power Grid Health"
                                       Foreground="#888"
                                       FontSize="11"/>
                            <TextBlock x:Name="TxtPowerHealth"
                                       Text="Waiting for telemetry..."
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#ffaa00"
                                       TextWrapping="Wrap"/>
                            <ProgressBar x:Name="PowerLoadProgressBar"
                                         Minimum="0"
                                         Maximum="10000"
                                         Height="8"
                                         Margin="0,6,0,0"
                                         Background="#444"
                                         Foreground="#00d4ff"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Dashboard Status"
                                       Foreground="#888"
                                       FontSize="11"/>
                            <TextBlock x:Name="TxtDashboardStatus"
                                       Text="Ready"
                                       Foreground="#00d4ff"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button x:Name="BtnGenerateSingle"
                                Content="Generate Single"
                                Background="#0f3460"
                                Foreground="#00d4ff"
                                FontWeight="Bold"
                                Click="BtnGenerateSingle_Click"
                                Margin="0,10,0,10"
                                Padding="8"/>

                        <Button x:Name="BtnGenerateBatch"
                                Content="Generate Batch (50)"
                                Background="#0f3460"
                                Foreground="#00d4ff"
                                FontWeight="Bold"
                                Click="BtnGenerateBatch_Click"
                                Margin="0,0,0,10"
                                Padding="8"/>

                        <Button x:Name="BtnRegisterSensor"
                                Content="Register Sensor"
                                Background="#0f3460"
                                Foreground="#00d4ff"
                                FontWeight="Bold"
                                Click="BtnRegisterSensor_Click"
                                Padding="8"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
