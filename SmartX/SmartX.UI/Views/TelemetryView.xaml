<UserControl x:Class="SmartX.UI.Views.TelemetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartX.UI.Views"
             Background="#1a1a2e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:NavBarControl x:Name="NavBar" Grid.Row="0"/>

        <StackPanel Grid.Row="1" Background="#0f3460" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
            <TextBlock Text="SMART-X DASHBOARD" FontSize="24" FontWeight="Bold" Foreground="#00d4ff" VerticalAlignment="Center"/>
            <TextBlock x:Name="ApiStatusBadge" Text="API: ONLINE" Foreground="#00ff00" FontSize="12" Margin="300,0" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBlock Text="Last Update:" Foreground="#888" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="LastUpdateTime" Text="00:00:00" Foreground="#00d4ff" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,15" Height="50">
                <Button x:Name="BtnViewTelemetry" Content="View Telemetry" Width="140" Background="#0f3460" Foreground="#00d4ff" FontWeight="Bold" Click="BtnViewTelemetry_Click" Margin="0,0,10,0"/>
                <TextBox x:Name="SearchInput" Width="250" Background="#2a2a3e" Foreground="#fff" Padding="10" TextChanged="SearchInput_TextChanged" Margin="0,0,10,0"/>
                <Button x:Name="BtnSearchHistory" Content="Search Local Historical Data" Width="160" Background="#0f3460" Foreground="#00d4ff" FontWeight="Bold" Click="BtnSearchHistory_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnClearSearch" Content="Clear Search" Width="110" Background="#0f3460" Foreground="#00d4ff" FontWeight="Bold" Click="BtnClearSearch_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnRunPerformanceTest" Content="Run Performance Test " Click="BtnRunPerformanceTest_Click"  Width="160" Background="#ff4444" Foreground="#fff" FontWeight="Bold" >

                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="100"
                      Click="PerformanceTest100_Click"/>

                            <MenuItem Header="1000"
                      Click="PerformanceTest1000_Click"/>

                            <MenuItem Header="5000"
                      Click="PerformanceTest5000_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>

                </Button>
            </StackPanel>
            <TabControl Grid.Row="1" Grid.Column="0" Background="#2a2a3e" BorderBrush="#444" BorderThickness="1">
                <TabItem Header="Local Telemetry">
                    <Border Background="#2a2a3e">
                        <DataGrid x:Name="TelemetryDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#1a1a2e" Foreground="#00d4ff" GridLinesVisibility="None" RowBackground="#2a2a3e" AlternatingRowBackground="#252535" MouseDoubleClick="TelemetryRecordGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="120" Foreground="#00d4ff"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding LocationZone}" Width="110" Foreground="#00d4ff"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" Foreground="#00d4ff"/>
                                <DataGridTextColumn Header="Sensor Value" Binding="{Binding SensorValue}" Width="100" Foreground="#00d4ff"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100" Foreground="#ffaa00"/>
                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140" Foreground="#00d4ff"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
                <TabItem Header="Shared API Telemetry">
                    <Grid Background="#2a2a3e" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="BtnGenerateWithApi" Content="Generate Telemetry (API +10)" Width="170" Background="#0f3460" Foreground="#00d4ff" FontWeight="Bold" Click="BtnGenerateWithApi_Click" Margin="0,0,10,0"/>
                            <Button x:Name="BtnRefreshApiData" Content="Refresh from API" Width="140" Background="#0f3460" Foreground="#00d4ff" FontWeight="Bold" Click="BtnRefreshApiData_Click" Margin="0,0,20,0"/>
                            <TextBlock Text="Registered Sensors:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtApiSensorCount" Text="0" Foreground="#00ff00" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <TextBlock Text="Shared API Generated:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtApiGeneratedInline" Text="0" Foreground="#ffaa00" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#2a2a3e" BorderBrush="#444" BorderThickness="1" CornerRadius="5">
                            <DataGrid x:Name="ApiDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#1a1a2e" Foreground="#00d4ff" GridLinesVisibility="None" RowBackground="#2a2a3e" AlternatingRowBackground="#252535" MouseDoubleClick="TelemetryRecordGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="120" Foreground="#00d4ff"/>
                                    <DataGridTextColumn Header="Location" Binding="{Binding LocationZone}" Width="110" Foreground="#00d4ff"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" Foreground="#00d4ff"/>
                                    <DataGridTextColumn Header="Value / Description" Binding="{Binding SensorValue}" Width="140" Foreground="#00d4ff"/>
                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140" Foreground="#ffaa00"/>
                                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140" Foreground="#00d4ff"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" Grid.Column="0" Margin="0,15,15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#2a2a3e" BorderBrush="#ff4444" BorderThickness="1" CornerRadius="5" Margin="0,0,7,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="ACTIVE ALERTS" FontSize="12" FontWeight="Bold" Foreground="#ff4444" Margin="0,0,0,10"/>
                        <ListBox x:Name="AlertsListBox" Background="#1a1a2e" BorderThickness="0" MaxHeight="100" Foreground="#ff6666" MouseDoubleClick="AlertsListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" FontSize="11" Margin="5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#ff6666"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                        <Setter Property="Foreground" Value="#666666"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#2a2a3e" BorderBrush="#00aa55" BorderThickness="1" CornerRadius="5" Margin="7,0,0,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="RESOLVED ALERTS" FontSize="12" FontWeight="Bold" Foreground="#00cc66" Margin="0,0,0,10"/>
                        <ListBox x:Name="ResolvedAlertsListBox" Background="#1a1a2e" BorderThickness="0" MaxHeight="100" Foreground="#66cc99" MouseDoubleClick="ResolvedAlertsListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" Foreground="#66cc99" FontSize="11" Margin="5"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Margin="15,0,0,0" Background="#2a2a3e" BorderBrush="#444" BorderThickness="1" CornerRadius="5" Padding="20">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="SYSTEM METRICS" FontSize="14" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,20"/>
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Total Sensors" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtTotalSensors" Text="0" FontSize="20" FontWeight="Bold" Foreground="#00ff00"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Telemetry Generated" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtTelemetryGenerated" Text="0" FontSize="16" FontWeight="Bold" Foreground="#00d4ff"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Telemetry Received" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtTelemetryReceived" Text="0" FontSize="16" FontWeight="Bold" Foreground="#00d4ff"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Total Records Stored" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtTotalRecordsStored" Text="0" FontSize="16" FontWeight="Bold" Foreground="#00ff00"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Last Telemetry Reading" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtLastReading" Text="--:--:--" FontSize="14" FontWeight="Bold" Foreground="#00d4ff"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Insertion Time (ms)" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtInsertionTime" Text="0" FontSize="14" FontWeight="Bold" Foreground="#ffaa00"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Search Time (ms)" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtSearchTime" Text="0" FontSize="14" FontWeight="Bold" Foreground="#ffaa00"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="API Generated" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtApiGenerated" Text="0" FontSize="14" FontWeight="Bold" Foreground="#ffaa00"/>
                    </StackPanel>
                    <Button x:Name="BtnGenerateSingle" Content="Generate Single" Width="280" Background="#0f3460" Foreground="#00d4ff" FontWeight="Bold" Click="BtnGenerateSingle_Click" Margin="0,20,0,10"/>
                    <Button x:Name="BtnGenerateBatch" Content="Generate Batch (50)" Width="280" Background="#0f3460" Foreground="#00d4ff" FontWeight="Bold" Click="BtnGenerateBatch_Click" Margin="0,0,0,10"/>
                    <Button x:Name="BtnRegisterSensor" Content="Register Sensor" Width="280" Background="#0f3460" Foreground="#00d4ff" FontWeight="Bold" Click="BtnRegisterSensor_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>